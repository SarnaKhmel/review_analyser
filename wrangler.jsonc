{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "review-analyser",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Express and node:crypto run on the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  // got does not run on Workers: google-play-scraper gets a fetch-based stand-in instead.
  "alias": { "got": "./src/gotFetch.ts" },
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from the static assets, without invoking the Worker.
    "run_worker_first": ["/api/*"]
  },
  // No id: wrangler creates the namespace on the first deploy and reuses it afterwards.
  "kv_namespaces": [{ "binding": "CACHE" }],
  "observability": { "enabled": true }
}
